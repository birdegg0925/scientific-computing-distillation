      "command": [
        "python",
        "-m",
        "sci_mopd.cli",
        "sft",
        "--data",
        "data_pilot/train.jsonl",
        "--out",
        "verification/teacher_code",
        "--model",
        "verification/random_hf_model",
        "--stage",
        "code",
        "--pool",
        "teacher_sft",
        "--steps",
